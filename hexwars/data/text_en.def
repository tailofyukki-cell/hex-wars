# text_en.def - UI strings in English (loaded on top of text_ja.def)
#
# Only the keys written here are replaced. A key missing from this file
# falls back to the Japanese text, so the game never shows a raw key.
# Keep every %d / %s in the same count and order as text_ja.def.
# Note: '#' starts a comment anywhere on a line, so it cannot be used in text.
# Leading spaces are trimmed; use a no-break space (U+00A0) when one is needed.

# --- common ---
FACTION0        = Western Alliance
FACTION1        = Eastern Federation
FACTION2        = Southern Union
FACTION3        = Northern Pact
FACTION4        = Free Army
NEUTRAL         = Neutral
REL_SELF        =
REL_ALLY        =  (Allied)
REL_ENEMY       =  (Enemy)
ON              = ON
OFF             = OFF

