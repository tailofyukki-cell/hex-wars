# ---- 超兵器（研究所で解隊して貯めた研究ポイントと、同じ額の資金で建造する）----
# superweapon = 1 陸（自軍の工場で建造）/ 2 空（自軍の空港）/ 3 海（自軍の港）。
# cost が必要な研究ポイントと資金の両方。建造は3手番。1陣営に各領域1体まで。
# 生産メニューからは買えない（no_produce）。進化もしない。

# 超重戦車: 動きは遅いが、射程1〜4を減衰なしで撃てる。2マス以上離れて撃てば
# 直接攻撃の相手からは反撃されない。攻撃は重戦車の約1.3倍、防御は大きく上げた。
[unit SW_TANK]
image     = gfx/units/common/htank.png
cutin     = gfx/cutin/tank.png
name      = 超重戦車「Gx-1型」
name1     = 超重戦車「ZK-100」
name2     = 猛獁
name3     = 三十七式超重戦車
name4     = 鉄の山
name@en   = Gx-1 Super-Heavy Tank
name1@en  = ZK-100 Super-Heavy Tank
name2@en  = Mammoth
name3@en  = Type 37 Super-Heavy Tank
name4@en  = Iron Mountain
icon      = 巨
icon@en   = ST
class     = LAND_TRACK
armor     = HARD
cost      = 3000
move      = 2
fuel      = 60
ammo      = 8
vision    = 2
atk_soft  = 98
atk_hard  = 91
atk_air   = 15
atk_sea   = 20
def       = 90
range_min = 1
range_max = 4
no_falloff = 1
superweapon = 1
no_produce = 1

