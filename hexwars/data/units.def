# ---- 艦船の拡充（港で生産。セーブ互換のため末尾追加） ----

# 戦艦: 射程2-5の巨砲を持つ海の主力。対地・対艦に絶大、鈍足で対空は苦手
[unit BATTLESHIP]
image     = gfx/units/battleship.png
# 戦闘アニメ動画のサンプル（ユニット毎に別の動画を指定できる）
anim      = gfx/anim/sample_sea.gif
name      = 戦艦「Rz-9型」
icon      = 艦
class     = SEA
armor     = SEA
cost      = 900
move      = 4
fuel      = 99
ammo      = 6
vision    = 3
atk_soft  = 85
atk_hard  = 80
atk_air   = 25
atk_sea   = 75
def       = 70
range_min = 2
range_max = 5
move_and_fire = 0

# 空母: 航空ユニットを2機まで搭載して海を越えて運ぶ洋上基地（隣接ヘクスへ発艦）。
# 搭載中の航空機はターン開始時に空港と同様に燃料・弾薬回復＋HP+2修理される
[unit CARRIER]
image     = gfx/units/carrier.png
name      = 空母「Hy-4型」
icon      = 母
class     = SEA
armor     = SEA
cost      = 850
move      = 5
fuel      = 99
ammo      = 0
vision    = 5
atk_soft  = 0
atk_hard  = 0
atk_air   = 30
atk_sea   = 10
def       = 55
capacity  = 2
resupply_cargo = 1

