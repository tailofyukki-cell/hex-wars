# 補給車（ammo=補給物資、最大10を搭載）。隣接味方に燃料・弾薬を補給（物資-1/体、
# 手動「補給」＋手番開始時に自動）、コマンド「回復」で物資10を使い1HP回復（1回1HPのみ）。
# 物資は自軍の都市・工場・首都に乗るとターン開始時に満タン(10)まで補充。
[unit SUPPLY]
image     = gfx/units/supply.png
name      = 補給車
icon      = 給
class     = LAND_WHEEL
armor     = HARD
cost      = 200
move      = 5
fuel      = 80
ammo      = 100
vision    = 1
atk_soft  = 0
atk_hard  = 0
atk_air   = 0
atk_sea   = 0
def       = 12
supply    = 1
transport_by = T_SHIP

# 補給機（航空用の補給車。物資最大10。空港でターン開始時に補充）
[unit SUPPLY_AIR]
image     = gfx/units/supply_air.png
name      = 補給機「Cg-5型」
icon      = 補
class     = AIR
armor     = AIR
cost      = 280
move      = 7
fuel      = 55
ammo      = 100
vision    = 2
atk_soft  = 0
atk_hard  = 0
atk_air   = 0
atk_sea   = 0
def       = 20
supply    = 1

