name3@en  = Type 17 Supply Truck
name4@en  = Field Kitchen
evolve_to    = SUPPLY_V
icon      = 給
icon@en   = Sp
class     = LAND_WHEEL
armor     = HARD
cost      = 200
move      = 5
fuel      = 80
ammo      = 100
vision    = 1
atk_soft  = 0
atk_hard  = 0
atk_air   = 0
atk_sea   = 0
def       = 12
supply    = 1
transport_by = T_SHIP

