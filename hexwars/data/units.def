#      途中に挟むと既存のセーブの部隊が別の種別に化ける） ----

# 駆潜艇: 潜水艦狩りの特務艦。潜水艦を遠くから見つけて（sonar）強く撃つ（atk_sub）が、
# 水上艦・陸・空にはほとんど歯が立たない。潜水艦＞水上艦＞駆潜艇＞潜水艦 の三すくみの一角。
# 霧の中では「潜水艦がもういない」ことを確かめる手段が無いので、見張りとして持つだけでも意味がある。
[unit SUBCHASER]
image     = gfx/units/common/subchaser.png
cutin     = gfx/cutin/ship.png
name      = 駆潜艇「Uj-2型」
name1     = 小型対潜艦「計画52号」
name2     = 海豹
name3     = 三十六式駆潜艇
name4     = 潜り狩り
name@en   = Uj-2 Subchaser
name1@en  = Project 52 Small ASW Ship
name2@en  = Seal
name3@en  = Type 36 Subchaser
name4@en  = Sub Hunter
evolve_to    = SUBCHASER_V
icon      = 哨
icon@en   = SC
class     = SEA
armor     = SEA
cost      = 300
move      = 7
fuel      = 80
ammo      = 6
vision    = 4
atk_soft  = 10
atk_hard  = 5
atk_air   = 20
atk_sea   = 20
atk_sub   = 85
def       = 30
anti_sub  = 1
sonar     = 4

