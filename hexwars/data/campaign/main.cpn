# main.cpn - キャンペーン「西方の反攻」全16作戦（うち海戦6: M04/M05/N1/N2/N3/N4）
# 終盤の N3/N4 は陸・海・空をすべて使う複合兵科マップ
# 西方同盟の一師団司令官として東方連邦の侵攻を押し返し、敵首都へ進撃する
#
# --- event の書き方 ---
#   event = 条件 | 動作 | 画面に出すメッセージ
# 各イベントは1作戦につき1回だけ発火する（発火済みかはセーブに残る）。1作戦16個まで。
# 陣営は 0=自軍 1=敵軍。天候は 0=晴 1=曇 2=雨。
#
# 条件:
#   TURN:n              n ターン目に到達した
#   BLD:陣営:n          その陣営の拠点が n 個以上
#   LOSS:陣営:n         その陣営の損失が n 部隊以上
#   AREA:陣営:x,y:半径  その陣営のユニットがその範囲に入った
#   CAPTURED:陣営:x,y   その座標の拠点をその陣営が所有した
#   WEATHER:天候        今その天候である
#
# 動作:
#   MSG                    メッセージだけ
#   SPAWN:陣営:ID:x,y[:数] ユニットをその付近に出す（置けない地形なら近くを探す）
#   FUNDS:陣営:額          資金を与える
#   WEATHER:天候[:ターン]  天候を変えて固定する（既定3ターン）
#   TERRAIN:x,y:地形文字   地形を差し替える（橋を落とす等。拠点なら所有も消える）
#   COPOWER:陣営           その陣営の指揮官の必殺技を強制発動する
#   HP:陣営:増減           その陣営の全ユニットのHPを増減（負も可。HP1未満にはしない）

[campaign]
name  = 西方の反攻
start = M01

[node M01]
art   = gfx/brief/m01.png
reward = gfx/reward/m01.png
# クリア時に動画を流したい場合は reward_video を指定する（mp4/GIF可・画像より優先）
#reward_video = gfx/anim/m01_clear.mp4
title = 第1作戦「国境の哨戒線」
map   = maps/c01_border.map
brief = 東方連邦軍が国境を越えた。哨戒線一帯の敵前衛部隊を撃破し、
brief = 国境地帯の敵司令部を制圧せよ。
brief = 歩兵で都市を占領して収入を確保しつつ、工場で戦力を整えること。
brief = （10ターン以内に勝利すれば敵の防衛線構築前に進撃でき、次の防衛戦を回避できる）
# --- 幕間（story = 話者|セリフ。話者空で地の文） ---
story = 東方連邦軍が国境を越えた。宣戦布告は無かった。
story = ミラ少尉|司令、哨戒線が三か所で破られました。前衛が持ちません。
story = ミラ少尉|……ご指示を。ここで止められなければ、次は本土です。
next_win      = M02
next_win_fast = M03
fast_turns    = 10
next_lose     = LOSE
carry  = 1
bonus  = 500
enemy  = EASY
enemy_co = GRAF   # 第1作戦: 従来の既定のまま＝難易度据え置き
sub = MAX_TURNS:12:12ターン以内に勝利する
sub = MAX_LOSS:2:損失2部隊以内で勝利する
event = TURN:8 | SPAWN:1:INFANTRY:26,19:2 | 敵の後続部隊が前線に到着した！

[node M02]
art   = gfx/brief/m02.png
reward = gfx/reward/m02.png
title = 第2作戦「森林の防衛線」
map   = maps/c02_forest.map
brief = 敵の機甲部隊が反撃に転じた。我が方の戦力は劣勢である。
brief = 森と都市の地形防御を活かし、18ターンのあいだ首都を守り抜け。
brief = ターン切れまで首都を保持すれば勝利となる。
# --- 幕間（story = 話者|セリフ。話者空で地の文） ---
story = 押し返せなかった。戦線は森林地帯まで下がっている。
story = ヴェルナー参謀|増援は十八ターン後だ。それまで首都を渡すな。
story = ミラ少尉|森と都市に潜って粘りましょう。守るのは得意です。
