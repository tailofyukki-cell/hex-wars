# --- English ---
title@en = Operation 12: Decisive Battle on the Plains
brief@en = The enemy field army's main force has deployed on the plains. Destroy it
brief@en = and the road to the capital opens. It will be a great tank battle.
brief@en = Don't neglect SP gun support fire or air defense.
story@en = Marshal Zakharov|So you've come this far, commander of the West.
story@en = Marshal Zakharov|But tricks don't work on the plains. Numbers and steel decide it.
story@en = Lt. Mira|...Shall I cut the radio, Commander?
story@en = Staff Officer Werner|No need. He's uneasy too.
story_win@en = Marshal Zakharov|...Splendid. That was no trick.
story_win@en = Lt. Mira|The marshal has withdrawn. The radio's gone silent too.
story_win@en = Staff Officer Werner|He lost on the plains. Little stands between us and his homeland now.
sub_desc@en = Win within 35 turns
sub_desc@en = Win losing no more than 8 units
event_msg@en = An enemy armored division has deployed!
event_msg@en = News of our victories reached home. Extra funds approved

[node N2]
