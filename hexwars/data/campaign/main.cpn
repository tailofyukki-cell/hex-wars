# --- English ---
title@en = Operation 14: Three-Way Crossroads
brief@en = The Southern Union left the joint front and dug in on the key hill on its own.
brief@en = Neither we nor they have any allies. It's a three-way melee.
brief@en = To avoid a two-front war, it may pay to wait for the other two to clash.
brief@en = (Hold 17 bases to win without crushing both armies.)
story@en = The Southern Union dug in on the key hill on its own.
story@en = Lt. Mira|They say the joint front is over. They wouldn't tell me why.
story@en = Staff Officer Werner|I told you. That nation acts in its own interest.
story@en = Lt. Mira|It's three-way now. We could wait for the other two to clash.
story_win@en = Lt. Mira|We won the three-way battle. The Southern Union is pulling back west.
story_win@en = Staff Officer Werner|Don't pursue. We can't afford more enemies right now.
sub_desc@en = Hold at least 14 bases
sub_desc@en = Destroy at least 12 units from both armies combined
event_msg@en = Engineers arrived. Cut the roads to slow both armies down.
event_msg@en = The Federation and the Union clashed on the hill. Strike now!
event_msg@en = Losing too many bases, the Federation brings in rockets!

[node N3]
art   = gfx/brief/m03.png
reward = gfx/reward/m03.png
title = 第15作戦「三角州の攻防」
map   = maps/c13_delta.map
brief = 敵本土の手前に、内海を抱いた広大な三角州が横たわる。
brief = 内海は東西に深く食い込み、艦砲は両岸の陸戦を直接支援できる。
brief = 南北の陸橋は狭く、機甲部隊はそこを通るしかない。
brief = 湾内の島を輸送艦で獲れば、艦隊と航空隊の前進基地になる。
brief = 陸・海・空を噛み合わせて進め。どれか一つでは抜けない。
# --- 幕間（story = 話者|セリフ。話者空で地の文） ---
story = ミラ少尉|三角州です。陸も海も空も、全部使うことになります。
story = ヴェルナー参謀|ここを抜ければ、敵首都は目と鼻の先だ。
# --- 勝利直後の幕間 ---
story_win = ミラ少尉|三角州を抜けました。陸海空、よく噛み合いました。
story_win = ヴェルナー参謀|敵首都は目と鼻の先だ。準備を怠るな。
next_win  = N2
next_lose = LOSE
carry  = 1
bonus  = 1300
enemy  = HARD
enemy_co = KARLA  # 三角州: 島と陸橋を絡めた粘り強い防御
sub = CAPTURE:16:拠点を16個以上確保する（開始12＝湾内と陸橋の中立を4個獲る）
sub = MAX_TURNS:45:45ターン以内に勝利する
event = TURN:14 | SPAWN:1:DESTROYER:35,15:2 | 敵増援艦隊が内海に進入した！
event = LOSS:1:10 | FUNDS:0:1200 | 内海の制海権が傾き、追加予算が下りた
event = CAPTURED:0:18,12 | COPOWER:1 | 北の島の港を奪われた敵指揮官が全軍に反撃を命じた！
event = TURN:26 | WEATHER:2:6 | 三角州に季節風が吹き込み、激しい雨になった

# --- English ---
title@en = Operation 15: Battle of the Delta
brief@en = Before the enemy homeland lies a vast delta embracing an inland sea.
brief@en = The inland sea cuts deep, so naval guns can directly support fighting on both shores.
brief@en = The land bridges to the north and south are narrow, and armor has no other way through.
brief@en = Take the island in the bay with transports to gain a forward base for ships and aircraft.
brief@en = Mesh land, sea, and air together. No single arm will break through.
story@en = Lt. Mira|The delta. We'll need land, sea, and air, all of it.
story@en = Staff Officer Werner|Get through here and the enemy capital is right in front of us.
story_win@en = Lt. Mira|We're through the delta. Land, sea, and air meshed well.
story_win@en = Staff Officer Werner|The enemy capital is right ahead. Don't slack on preparations.
sub_desc@en = Hold at least 16 bases (you start with 12: take 4 neutral ones in the bay)
sub_desc@en = Win within 45 turns
event_msg@en = Enemy fleet reinforcements entered the inland sea!
event_msg@en = The inland sea is tilting our way. Extra funds approved
event_msg@en = Losing the north island port, the enemy counterattacks!
event_msg@en = Monsoon winds sweep the delta, bringing heavy rain

[node N4]
art   = gfx/brief/m09.png
reward = gfx/reward/m09.png
title = 第17作戦「湾岸の要塞」
map   = maps/c14_bastion.map
brief = 首都の手前に最後の障壁がある。半島に築かれた湾岸要塞だ。
brief = 中央の山稜は隘路が二本、川を渡れる橋も二本しかない。
brief = 陸路だけでは押し切れない。北の湾から艦砲で要塞北岸を叩き、
brief = 制空権を取ってから上陸部隊を送り込め。
brief = ここを抜けば、あとは敵首都のみだ。
# --- 幕間（story = 話者|セリフ。話者空で地の文） ---
story = ミラ少尉|湾を封じている要塞です。ここが最後の蓋になります。
story = ザハロフ元帥|引く気はない。この壁は貴官の骨で埋まる。
story = ミラ少尉|……随分と余裕がなくなりましたね、元帥閣下。
# --- 勝利直後の幕間 ---
story_win = ミラ少尉|要塞、陥落しました。湾が開きます。
story_win = ヴェルナー参謀|最後の蓋が外れた。元帥に残っているのは首都だけだ。
next_win  = M10
next_lose = LOSE
carry  = 1
bonus  = 1600
enemy  = HARD
enemy_co = WOLF   # 湾岸要塞: 要塞に籠もって削ってくる
sub = MAX_TURNS:55:55ターン以内に要塞を陥落させる
sub = MIN_KILLS:14:敵を14部隊以上撃破する
event = TURN:16 | SPAWN:1:AA_GUN:44,22:2 | 要塞の対空砲台が増強された！
event = AREA:0:42,21:6 | SPAWN:1:HTANK:45,25:2 | 要塞守備隊の重戦車が出撃した！
# TERRAIN で橋を川に戻す。渡河点が北の一本だけになり、進路が絞られる
event = TURN:18 | TERRAIN:19,22:r | 敵が南の橋を爆破した！残る渡河点は北の一本のみ
event = CAPTURED:0:27,17 | FUNDS:0:1000 | 山稜の隘路を確保。後方から補給が届いた

# --- English ---
title@en = Operation 17: Harbor Fortress
brief@en = One last barrier stands before the capital: a harbor fortress built on a peninsula.
brief@en = The central ridge has only two passes, and only two bridges cross the river.
brief@en = The land route alone won't break it. Shell its north shore from the northern bay,
brief@en = win the skies, then send in the landing force.
brief@en = Break through here and only the enemy capital remains.
story@en = Lt. Mira|That fortress seals the bay. It's the last lid.
story@en = Marshal Zakharov|I will not yield. Your bones will fill this wall.
story@en = Lt. Mira|...You've lost some of your composure, Marshal.
story_win@en = Lt. Mira|The fortress has fallen. The bay is open.
story_win@en = Staff Officer Werner|The last lid is off. All the marshal has left is his capital.
sub_desc@en = Take the fortress within 55 turns
sub_desc@en = Destroy at least 14 enemy units
event_msg@en = The fortress AA batteries have been reinforced!
event_msg@en = Fortress heavy tanks have sortied!
event_msg@en = Enemy blew the south bridge! Only the north crossing is left
event_msg@en = Ridge pass secured. Supplies arrived from the rear

[node M10]
art   = gfx/brief/m10.png
reward = gfx/reward/m10.png
title = 第18作戦「首都攻略」
map   = maps/c04_capital.map
brief = 敵本土に橋頭堡を確保した。残るは北東の要塞首都のみ。
brief = 首都は山稜に囲まれ、進路は二本の街道に絞られている。
brief = だが南東の湾が首都の東まで回り込んでいる。艦砲で山越えの守りを叩き、
brief = 街道の敵を排除して押し上がれ。陸・海・空のすべてを使い切る戦いになる。
brief = この戦いで大陸の命運が決まる。
# --- 幕間（story = 話者|セリフ。話者空で地の文） ---
story = 長い戦線の果てに、敵首都が視界に入った。
story = ヴェルナー参謀|ここまでだ。あとは貴官の指揮に任せる。
story = ミラ少尉|司令。……終わらせましょう。
# --- 勝利直後の幕間 ---
story_win = 砲声が止んだ。首都の上に、白い旗が上がっている。
story_win = ザハロフ元帥|……そちらの勝ちだ。よく戦った。
story_win = ミラ少尉|司令。終わりました。……本当に、終わりました。
next_win  = M19
next_lose = LOSE
carry  = 1
bonus  = 0
enemy  = HARD
enemy_co = BALT   # 最終決戦: 最も攻撃的
sub = MAX_LOSS:8:損失8部隊以内で首都を落とす
sub = MIN_KILLS:12:敵を12部隊以上撃破する
# マップを作り直して首都が北東へ移ったので、発火位置も進路上へ寄せた
event = AREA:0:28,8:5 | SPAWN:1:HTANK:28,8:2 | 首都防衛隊が最後の抵抗を見せる！
event = TURN:20 | SPAWN:1:ROCKET:28,8:2 | 敵が予備のロケット砲隊を投入した！
event = CAPTURED:0:35,9 | COPOWER:1 | 軍港を失った敵が最後の力を振り絞る！

# --- English ---
title@en = Operation 18: Assault on the Capital
brief@en = We hold a bridgehead on the enemy homeland. Only the fortress capital to the northeast remains.
brief@en = The capital is ringed by ridges, and the approach narrows to two highways.
brief@en = But a bay in the southeast wraps around to the east of the capital.
brief@en = Pound the defenses beyond the ridge with naval guns, clear the highways, and push up.
brief@en = It will take everything we have on land, sea, and air.
brief@en = This battle will decide the fate of the continent.
story@en = At the end of a long front, the enemy capital came into view.
story@en = Staff Officer Werner|This is it. The rest is up to your command.
story@en = Lt. Mira|Commander. ...Let's end this.
story_win@en = The guns fell silent. A white flag rises over the capital.
story_win@en = Marshal Zakharov|...The victory is yours. You fought well.
story_win@en = Lt. Mira|Commander. It's over. ...It's really over.
sub_desc@en = Take the capital losing no more than 8 units
sub_desc@en = Destroy at least 12 enemy units
event_msg@en = The capital guard makes its last stand!
event_msg@en = The enemy commits its reserve rocket batteries!
event_msg@en = Having lost the naval port, the enemy gives it everything!

[node M19]
art   = gfx/brief/m19.png
reward = gfx/reward/m19.png
title = 第19作戦「総力戦」
map   = maps/c19_totalwar.map
brief = 首都を失った東方連邦が、残る全戦力をこの一戦に投入してきた。
brief = **開幕の敵はこちらと同数。だが増援が2波に分かれて到着する。**
brief = 3ターン目には敵の数はこちらの倍になる。それまでに陣を整えろ。
brief = 陸・海・空のすべてが揃う戦場だ。持ち越した部隊は惜しまず出せ。
brief = 中央の山脈を越えられるのは3か所、その東の川を渡れるのは2か所だけだ。
# --- 幕間（story = 話者|セリフ。話者空で地の文） ---
story = ミラ少尉|司令、敵の全部隊が動いています。後方の予備まで、全部です。
story = ヴェルナー参謀|首都を失って、まだこれだけ出せるのか。
story = ミラ少尉|……最初は同数です。ですが二波、三波と来ます。最終的には倍かと。
story = ヴェルナー参謀|ならば、揃う前に形を作れ。あとは持ちこたえるだけだ。
story = グレーフ将軍は、この戦のために全てを取っておいたのだ。
# --- 勝利直後の幕間 ---
story_win = ミラ少尉|……敵、後退します。追撃可能な部隊、ありません。
story_win = ヴェルナー参謀|追わなくていい。あれが最後の一撃だった。
story_win = ヴェルナー参謀|次で終わりだ、少尉。
next_win  = M20
next_lose = LOSE
carry  = 1
bonus  = 2500
enemy  = HARD
enemy_co = GRAF   # 総力戦: 東方連邦の総司令官。最後に全部を出してくる
# 敵の総数を「自軍の展開数の200%」に揃え、超過分を2波に分けて
# 2・3ターン目に届ける。マップ側の敵は自軍と同数（24）にしてある。
enemy_scale = 200
enemy_waves = 2
sub = MAX_TURNS:40:40ターン以内に勝利する
sub = MAX_LOSS:20:損失20部隊以内で勝利する
sub = MIN_KILLS:60:敵を60部隊以上撃破する

# --- English ---
title@en = Operation 19: Total War
brief@en = Having lost its capital, the Eastern Federation has thrown every remaining force into this battle.
brief@en = **At the start the enemy matches your numbers, but reinforcements arrive in two waves.**
brief@en = By turn 3 the enemy will outnumber you two to one. Get your formation ready before then.
brief@en = Land, sea, and air are all here. Don't hold back the units you've carried over.
brief@en = Only 3 routes cross the central mountains, and only 2 cross the river to their east.
story@en = Lt. Mira|Commander, every enemy unit is moving. Even their rear reserves.
story@en = Staff Officer Werner|They lost the capital and can still field this much?
story@en = Lt. Mira|...Even numbers at first. But more waves are coming. Twice our size in the end.
story@en = Staff Officer Werner|Then take shape before they're all here. After that, just hold.
story@en = General Graf had saved everything for this battle.
story_win@en = Lt. Mira|...The enemy is withdrawing. We have no units able to pursue.
story_win@en = Staff Officer Werner|No need to chase. That was their last blow.
story_win@en = Staff Officer Werner|The next one ends it, Lieutenant.
sub_desc@en = Win within 40 turns
sub_desc@en = Win losing no more than 20 units
sub_desc@en = Destroy at least 60 enemy units

[node M20]
art   = gfx/brief/m20.png
reward = gfx/reward/m20.png
title = 最終作戦「残照」（第20作戦）
map   = maps/c20_lastlight.map
brief = 東方連邦の抵抗は終わった。残っているのは司令部の守備隊だけだ。
brief = 敵に増援は無い。持ち越した部隊で、静かに幕を引け。
brief = 敵首都を制圧すれば、この戦争は終わる。
# --- 幕間（story = 話者|セリフ。話者空で地の文） ---
story = ミラ少尉|敵司令部、確認しました。守備隊のみ。増援の兆候はありません。
story = ヴェルナー参謀|そうか。……昨日まで、あそこには一個軍がいたんだがな。
story = ミラ少尉|司令。最後の命令を。
story = 三年ぶりに、地図の上に敵の矢印が一本も無かった。
# --- 勝利直後の幕間 ---
story_win = ミラ少尉|敵司令部、制圧。……終わりました。全部。
story_win = ヴェルナー参謀|ああ。よく持ちこたえた。
story_win = 誰かが窓を開けた。砲声の無い朝の音がした。
next_win  = WIN
next_lose = LOSE
carry  = 1
bonus  = 1000
enemy  = NORMAL
enemy_co = HERTA  # 残照: 最後まで残ったのは主計将校だった
no_reinforce = 1  # 消化試合にする。持越しぶんの敵増援も出さない
sub = MAX_TURNS:15:15ターン以内に勝利する
sub = MAX_LOSS:1:損失1部隊以内で勝利する

# --- English ---
title@en = Final Operation: Last Light (Operation 20)
brief@en = The Eastern Federation's resistance is over. Only the command post garrison remains.
brief@en = The enemy has no reinforcements. With the units you carried over, bring the curtain down quietly.
brief@en = Take the enemy capital and this war is over.
story@en = Lt. Mira|Enemy command post confirmed. Garrison only. No sign of reinforcements.
story@en = Staff Officer Werner|I see. ...Until yesterday, a whole army stood there.
story@en = Lt. Mira|Commander. Your final order.
story@en = For the first time in three years, not one enemy arrow remained on the map.
story_win@en = Lt. Mira|Enemy command post taken. ...It's over. All of it.
story_win@en = Staff Officer Werner|Yes. You held out well.
story_win@en = Someone opened a window. It was the sound of a morning without guns.
sub_desc@en = Win within 15 turns
sub_desc@en = Win losing no more than 1 unit
