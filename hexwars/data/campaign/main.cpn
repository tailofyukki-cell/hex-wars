map   = maps/c06_beachhead.map
brief = 上陸には成功したが、敵の逆襲が始まった。増援の到着まで
brief = 16ターン、海岸の橋頭堡を守り抜け。
brief = 自走砲を後方に置き、都市の防御補正を活かして耐えること。
next_win  = M06
next_lose = LOSE
carry  = 1
bonus  = 800
enemy  = NORMAL
enemy_co = BALT   # 橋頭堡の死守: 敵が攻め手
sub = KEEP_BLD:8:橋頭堡の拠点を8個以上守り抜く
sub = MAX_LOSS:4:損失4部隊以内で勝利する
event = TURN:6 | SPAWN:1:TANK:25,19:2 | 敵の第一波が押し寄せる！
event = TURN:16 | SPAWN:1:HTANK:25,19:2 | 敵重戦車隊が投入された！

[node M06]
art   = gfx/brief/m06.png
reward = gfx/reward/m06.png
title = 第6作戦「山岳の隘路」
map   = maps/c07_pass.map
brief = 内陸へ通じる道は山脈に阻まれ、隘路は2本のみ。
brief = 狭い道では数の優位が活きない。対戦車兵と自走砲を先頭に、
brief = 一歩ずつ確実に押し込め。山を越えられるのは歩兵だけだ。
next_win  = M07
next_lose = LOSE
carry  = 1
bonus  = 700
enemy  = NORMAL
enemy_co = KARLA  # 山岳の隘路: 長期戦・索敵
sub = MAX_TURNS:30:30ターン以内に隘路を突破する
sub = MIN_KILLS:10:敵を10部隊以上撃破する
event = AREA:0:29,8:5 | SPAWN:1:ROCKET:29,8:2 | 隘路の奥に伏兵がいた！

[node M07]
art   = gfx/brief/m07.png
reward = gfx/reward/m07.png
title = 第7作戦「空の要衝」
map   = maps/c08_airfields.map
brief = 大湖のほとりに点在する中立飛行場群。ここを押さえた側が制空権を握る。
brief = 湖は地上部隊を通さない。歩兵で湖畔の飛行場を占領し、
brief = 戦闘機で敵の爆撃機を迎撃せよ。対空戦車の随伴を忘れるな。
next_win  = M08
next_lose = LOSE
carry  = 1
bonus  = 800
enemy  = NORMAL
enemy_co = EAGLE  # 空の要衝: 制空権を握られている
sub = CAPTURE:11:拠点を11個以上確保する
sub = SURVIVE:2:FIGHTER:戦闘機を2機以上生存させる
event = TURN:10 | SPAWN:1:FIGHTER:32,4:2 | 敵の増援航空隊が飛来した！

[node M08]
art   = gfx/brief/m08.png
reward = gfx/reward/m08.png
