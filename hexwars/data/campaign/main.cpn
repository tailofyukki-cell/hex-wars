# main.cpn - キャンペーン「西方の反攻」全20作戦（うち海戦6: M04/M05/N1/N2/N3/N4）
# 終盤の N3/N4/M19 は陸・海・空をすべて使う複合兵科マップ
# M19「総力戦」がラスボス。敵は自軍の展開数の2倍まで増える（enemy_scale）。
# M20「残照」は締めくくりなので、わざと軽くしてある。
# 西方同盟の一師団司令官として東方連邦の侵攻を押し返し、敵首都へ進撃する
#
# --- event の書き方 ---
#   event = 条件 | 動作 | 画面に出すメッセージ
# 各イベントは1作戦につき1回だけ発火する（発火済みかはセーブに残る）。1作戦16個まで。
# 陣営は 0=自軍 1=敵軍。天候は 0=晴 1=曇 2=雨。
#
# 条件:
#   TURN:n              n ターン目に到達した
#   BLD:陣営:n          その陣営の拠点が n 個以上
#   LOSS:陣営:n         その陣営の損失が n 部隊以上
#   AREA:陣営:x,y:半径  その陣営のユニットがその範囲に入った
#   CAPTURED:陣営:x,y   その座標の拠点をその陣営が所有した
#   WEATHER:天候        今その天候である
#
# 動作:
#   MSG                    メッセージだけ
#   SPAWN:陣営:ID:x,y[:数] ユニットをその付近に出す（置けない地形なら近くを探す）
#   FUNDS:陣営:額          資金を与える
#   WEATHER:天候[:ターン]  天候を変えて固定する（既定3ターン）
#   TERRAIN:x,y:地形文字   地形を差し替える（橋を落とす等。拠点なら所有も消える）
#   COPOWER:陣営           その陣営の指揮官の必殺技を強制発動する
#   HP:陣営:増減           その陣営の全ユニットのHPを増減（負も可。HP1未満にはしない）
#
# --- 大決戦用の敵数調整 ---
#   enemy_scale = 200   敵の総数を「自軍の展開数の200%」に揃える
#   enemy_waves = 2     超過分を2波に分けて2・3ターン目に到着させる
# 開幕時は常に自軍と同数で、接触が始まる頃に数が揃う。
# 指定すると、従来の「持越しで増えた分だけ敵に増援」は切り替わる。
# **マップ側の敵は自軍の初期数以下にしておくこと**（減らす処理は無い）。

[campaign]
name  = 西方の反攻
name@en = The Western Counteroffensive
start = M01

[node M01]
art   = gfx/brief/m01.png
reward = gfx/reward/m01.png
# クリア時に動画を流したい場合は reward_video を指定する（mp4/GIF可・画像より優先）
#reward_video = gfx/anim/m01_clear.mp4
title = 第1作戦「国境の哨戒線」
map   = maps/c01_border.map
brief = 東方連邦軍が国境を越えた。哨戒線一帯の敵前衛部隊を撃破し、
brief = 国境地帯の敵司令部を制圧せよ。
brief = 歩兵で都市を占領して収入を確保しつつ、工場で戦力を整えること。
brief = （10ターン以内に勝利すれば敵の防衛線構築前に進撃でき、次の防衛戦を回避できる）
# --- 幕間（story = 話者|セリフ。話者空で地の文） ---
story = 東方連邦軍が国境を越えた。宣戦布告は無かった。
story = ミラ少尉|司令、哨戒線が三か所で破られました。前衛が持ちません。
story = ミラ少尉|……ご指示を。ここで止められなければ、次は本土です。
# --- 勝利直後の幕間 ---
story_win = ミラ少尉|哨戒線、押し返しました。前衛はよく持ちこたえました。
story_win = ヴェルナー参謀|だが本隊はまだ動いていない。ここからが本番だ。
next_win      = M02
next_win_fast = M03
fast_turns    = 10
next_lose     = LOSE
carry  = 1
bonus  = 500
enemy  = EASY
enemy_co = GRAF   # 第1作戦: 従来の既定のまま＝難易度据え置き
sub = MAX_TURNS:12:12ターン以内に勝利する
sub = MAX_LOSS:2:損失2部隊以内で勝利する
event = TURN:8 | SPAWN:1:INFANTRY:26,19:2 | 敵の後続部隊が前線に到着した！

# --- English ---
title@en = Operation 1: Border Patrol Line
brief@en = The Eastern Federation has crossed the border. Destroy the enemy vanguard along the patrol line
brief@en = and take the enemy command post in the border region.
brief@en = Capture cities with infantry to secure income, and build up your forces at factories.
brief@en = (Win within 10 turns to advance before the enemy fortifies, and skip the next defensive battle.)
story@en = The Eastern Federation crossed the border. There was no declaration of war.
story@en = Lt. Mira|Commander, the patrol line is broken in three places. The vanguard can't hold.
story@en = Lt. Mira|...Your orders? If we can't stop them here, the homeland is next.
story_win@en = Lt. Mira|We pushed them back from the patrol line. The vanguard held well.
story_win@en = Staff Officer Werner|But their main force hasn't moved yet. The real fight starts now.
sub_desc@en = Win within 12 turns
sub_desc@en = Win losing no more than 2 units
event_msg@en = Enemy reinforcements have reached the front!

[node M02]
art   = gfx/brief/m02.png
reward = gfx/reward/m02.png
title = 第2作戦「森林の防衛線」
map   = maps/c02_forest.map
brief = 敵の機甲部隊が反撃に転じた。我が方の戦力は劣勢である。
brief = 森と都市の地形防御を活かし、18ターンのあいだ首都を守り抜け。
brief = ターン切れまで首都を保持すれば勝利となる。
# --- 幕間（story = 話者|セリフ。話者空で地の文） ---
story = 押し返せなかった。戦線は森林地帯まで下がっている。
story = ヴェルナー参謀|増援は十八ターン後だ。それまで首都を渡すな。
story = ミラ少尉|森と都市に潜って粘りましょう。守るのは得意です。
# --- 勝利直後の幕間 ---
story_win = 森は焼けたが、首都は残った。
story_win = ミラ少尉|守り切りましたね。……次は、こちらから行きましょう。
next_win  = M03
next_lose = LOSE
carry  = 1
bonus  = 800
enemy  = NORMAL
enemy_co = LIESE  # 森林の防衛線: 森を機動で迂回してくる
sub = KEEP_BLD:6:自軍拠点を6個以上維持したまま勝利する
sub = MAX_LOSS:4:損失4部隊以内で勝利する
event = TURN:10 | SPAWN:1:TANK:30,11:2 | 敵戦車隊が森を迂回して現れた！
event = LOSS:0:5 | SPAWN:0:INFANTRY:8,12:2 | 後方から予備兵力が到着した

# --- English ---
title@en = Operation 2: Forest Defense Line
brief@en = The enemy armor has gone on the counterattack. We are outnumbered.
brief@en = Use the defensive terrain of forests and cities, and hold the capital for 18 turns.
brief@en = Hold the capital until the turn limit and you win.
story@en = We couldn't push them back. The front has fallen back to the forests.
story@en = Staff Officer Werner|Reinforcements are eighteen turns out. Hold the capital until then.
story@en = Lt. Mira|Let's dig into the forests and cities. Defense is what we do best.
story_win@en = The forest burned, but the capital still stands.
story_win@en = Lt. Mira|We held. ...Next time, let's be the ones attacking.
sub_desc@en = Win while holding at least 6 of your bases
sub_desc@en = Win losing no more than 4 units
event_msg@en = Enemy tanks came around the forest!
event_msg@en = Reserve troops arrived from the rear

[node M03]
art   = gfx/brief/m03.png
reward = gfx/reward/m03.png
title = 第3作戦「河川突破」
map   = maps/c05_river.map
brief = 前線は大河で分断されている。渡河点は2本の橋のみ。
brief = 橋は敵も狙っている。自走砲で対岸を叩き、機甲部隊で一気に渡れ。
brief = 歩兵は川を徒渉できることも忘れるな。
brief = 今回から工兵が付く。隣接する地形を壊し、壊れた地形を直せる。
brief = 敵は橋を落としてくる。工兵を前に出しておけば掛け直せる（有料）。
brief = 逆に、こちらから橋を落として敵の機甲を足止めする手もある。
# --- 幕間（story = 話者|セリフ。話者空で地の文） ---
story = ミラ少尉|敵の前進が止まりました。補給が伸びきったようです。
story = ヴェルナー参謀|反撃の潮目だ。渡河して橋頭堡を取れ。
story = ミラ少尉|工兵中隊が到着しています。橋を落とすのも、直すのも、彼らの仕事です。
story = 二か月ぶりに、地図の矢印が東を向いた。
# --- 勝利直後の幕間 ---
story_win = ミラ少尉|渡河成功。対岸に橋頭堡を確保しました。
story_win = ミラ少尉|工兵の連中が、撃たれながら橋を掛け直しました。
story_win = ヴェルナー参謀|よくやった。この川は、もう我々の背中にある。
next_win  = M04
next_lose = LOSE
carry  = 1
bonus  = 600
enemy  = NORMAL
enemy_co = GRAF   # 河川突破: 渡河を阻む守り
sub = MAX_TURNS:25:25ターン以内に渡河を完了する
sub = MIN_KILLS:8:敵を8部隊以上撃破する
sub = SURVIVE:1:ENGINEER:工兵を1部隊以上生存させる
# 南の橋(19,14)を落とされる。元の地形は道路のままなので、
# 工兵を隣に付ければ修復できる（歩兵は徒渉できるので詰みにはならない）。
event = TURN:6 | TERRAIN:19,14:r | 敵が南の橋を落とした！工兵なら掛け直せる
event = AREA:0:33,19:6 | SPAWN:1:AT_INFANTRY:33,19:3 | 対岸の守備隊が反撃に出た！

# --- English ---
title@en = Operation 3: River Breakthrough
brief@en = The front is split by a great river, with only two bridges to cross.
brief@en = The enemy is after the bridges too. Shell the far bank with SP guns, then rush across with armor.
brief@en = Don't forget that infantry can wade across the river.
brief@en = From now on you have engineers. They can demolish adjacent terrain and repair damaged terrain.
brief@en = The enemy will blow the bridges. Keep engineers forward and you can rebuild them (for a fee).
brief@en = Or blow a bridge yourself to stall the enemy armor.
story@en = Lt. Mira|The enemy advance has stalled. Their supply lines are stretched thin.
story@en = Staff Officer Werner|The tide is turning. Cross the river and take a bridgehead.
story@en = Lt. Mira|The engineers are here. Blowing bridges and fixing them is their job.
story@en = For the first time in two months, the arrows on the map pointed east.
story_win@en = Lt. Mira|River crossed. We hold a bridgehead on the far bank.
story_win@en = Lt. Mira|The engineers rebuilt the bridge under fire.
story_win@en = Staff Officer Werner|Well done. This river is behind us now.
sub_desc@en = Complete the crossing within 25 turns
sub_desc@en = Destroy at least 8 enemy units
sub_desc@en = Keep at least 1 engineer unit alive
event_msg@en = The enemy blew the south bridge! Engineers can rebuild it
event_msg@en = The garrison on the far bank is counterattacking!

[node M04]
art   = gfx/brief/m04.png
reward = gfx/reward/m04.png
title = 第4作戦「海峡横断」
map   = maps/c03_channel.map
brief = 反攻の時が来た。海峡対岸の敵拠点へ上陸作戦を敢行する。
brief = 港で輸送艦を生産し、戦車・歩兵を積んで対岸へ渡れ。
brief = 敵の駆逐艦と航空機に注意。護衛の駆逐艦を随伴させること。
brief = （18ターン以内に勝利すれば敵の増援より先に内陸へ進撃できる）
# --- 幕間（story = 話者|セリフ。話者空で地の文） ---
story = ヴェルナー参謀|陸路は要塞化されている。海峡を渡るしかない。
story = ミラ少尉|輸送艦に部隊を積みます。……泳げますか、司令。
story = ミラ少尉|冗談です。落とされないよう護衛はつけますので。
# --- 勝利直後の幕間 ---
story_win = ミラ少尉|海峡を越えました。司令、泳がずに済みましたね。
story_win = ヴェルナー参謀|茶化すな。ここからは補給が海の上を通る。
next_win      = M05
next_win_fast = M06
fast_turns    = 18
next_lose     = LOSE
carry  = 1
bonus  = 1000
enemy  = NORMAL
enemy_co = WOLF   # 海峡横断: 敵艦隊が強い
sub = SURVIVE:1:T_SHIP:輸送艦を1隻以上生存させる
sub = MAX_LOSS:5:損失5部隊以内で勝利する
event = TURN:12 | SPAWN:1:DESTROYER:37,13:2 | 敵艦隊が海峡に増援を送り込んだ！

# --- English ---
title@en = Operation 4: Strait Crossing
brief@en = The time to strike back has come. Land on the enemy base across the strait.
brief@en = Build transport ships at a port and carry tanks and infantry to the far shore.
brief@en = Watch out for enemy destroyers and aircraft. Send destroyers along as escorts.
brief@en = (Win within 18 turns to push inland before enemy reinforcements arrive.)
story@en = Staff Officer Werner|The land route is fortified. We have to cross the strait.
story@en = Lt. Mira|Loading troops onto the transports. ...Can you swim, Commander?
story@en = Lt. Mira|Just kidding. We'll have escorts so they don't sink us.
story_win@en = Lt. Mira|We're across the strait. No swimming needed, Commander.
story_win@en = Staff Officer Werner|Don't joke. From here on our supplies travel by sea.
sub_desc@en = Keep at least 1 transport ship alive
sub_desc@en = Win losing no more than 5 units
event_msg@en = Enemy fleet reinforcements entered the strait!

[node M05]
art   = gfx/brief/m05.png
reward = gfx/reward/m05.png
title = 第5作戦「橋頭堡の死守」
map   = maps/c06_beachhead.map
brief = 上陸には成功したが、敵の逆襲が始まった。増援の到着まで
brief = 16ターン、海岸の橋頭堡を守り抜け。
brief = 自走砲を後方に置き、都市の防御補正を活かして耐えること。
# --- 幕間（story = 話者|セリフ。話者空で地の文） ---
story = 上陸には成功した。だが後続はまだ海の上だ。
story = ミラ少尉|敵の反撃が来ます。ここを明け渡したら全部やり直しです。
story = ヴェルナー参謀|耐えろ。持ちこたえた側が次の一手を持つ。
# --- 勝利直後の幕間 ---
story_win = 後続がようやく着いた。砂浜は、もう戦場ではない。
story_win = ミラ少尉|耐えた甲斐がありました。次の一手は、こちらのものです。
next_win  = M06
next_lose = LOSE
carry  = 1
bonus  = 800
enemy  = NORMAL
enemy_co = BALT   # 橋頭堡の死守: 敵が攻め手
sub = KEEP_BLD:8:橋頭堡の拠点を8個以上守り抜く
sub = MAX_LOSS:4:損失4部隊以内で勝利する
event = TURN:6 | SPAWN:1:TANK:25,19:2 | 敵の第一波が押し寄せる！
event = TURN:16 | SPAWN:1:HTANK:25,19:2 | 敵重戦車隊が投入された！

# --- English ---
title@en = Operation 5: Hold the Beachhead
brief@en = The landing succeeded, but the enemy counterattack has begun.
brief@en = Hold the beachhead on the coast for 16 turns until reinforcements arrive.
brief@en = Keep SP guns in the rear and use the defense bonus of cities to hold out.
story@en = The landing succeeded. But the follow-up force is still at sea.
story@en = Lt. Mira|Their counterattack is coming. Lose this and we start over.
story@en = Staff Officer Werner|Hold. Whoever holds out gets the next move.
story_win@en = The follow-up force finally arrived. The beach is no longer a battlefield.
story_win@en = Lt. Mira|It was worth holding. The next move is ours.
sub_desc@en = Hold at least 8 bases on the beachhead
sub_desc@en = Win losing no more than 4 units
event_msg@en = The enemy's first wave is coming!
event_msg@en = Enemy heavy tanks have been committed!

[node M06]
art   = gfx/brief/m06.png
reward = gfx/reward/m06.png
title = 第6作戦「山岳の隘路」
map   = maps/c07_pass.map
brief = 内陸へ通じる道は山脈に阻まれ、隘路は2本のみ。
brief = 狭い道では数の優位が活きない。対戦車兵と自走砲を先頭に、
brief = 一歩ずつ確実に押し込め。山を越えられるのは歩兵だけだ。
# --- 幕間（story = 話者|セリフ。話者空で地の文） ---
story = ミラ少尉|内陸へ抜ける道は、この隘路ひとつだけです。
story = ミラ少尉|山は戦車が通れません。歩兵で高地を押さえましょう。
# --- 勝利直後の幕間 ---
story_win = ミラ少尉|隘路を抜けました。内陸が開けています。
story_win = ヴェルナー参謀|敵はもう、地形に頼れん。
next_win  = M07
next_lose = LOSE
carry  = 1
bonus  = 700
enemy  = NORMAL
enemy_co = KARLA  # 山岳の隘路: 長期戦・索敵
sub = MAX_TURNS:30:30ターン以内に隘路を突破する
sub = MIN_KILLS:10:敵を10部隊以上撃破する
event = AREA:0:29,8:5 | SPAWN:1:ROCKET:29,8:2 | 隘路の奥に伏兵がいた！

# --- English ---
title@en = Operation 6: Mountain Pass
brief@en = The road inland is blocked by mountains, with only two narrow passes.
brief@en = Numbers mean little on narrow roads. Lead with anti-tank infantry and SP guns,
brief@en = and push forward one step at a time. Only infantry can cross the mountains.
story@en = Lt. Mira|This pass is the only way inland.
story@en = Lt. Mira|Tanks can't cross the mountains. Let's take the high ground with infantry.
story_win@en = Lt. Mira|We're through the pass. The interior lies open.
story_win@en = Staff Officer Werner|The enemy can't hide behind the terrain anymore.
sub_desc@en = Break through the pass within 30 turns
sub_desc@en = Destroy at least 10 enemy units
event_msg@en = An ambush was waiting deep in the pass!

[node M07]
art   = gfx/brief/m07.png
reward = gfx/reward/m07.png
title = 第7作戦「空の要衝」
map   = maps/c08_airfields.map
brief = 大湖のほとりに点在する中立飛行場群。ここを押さえた側が制空権を握る。
brief = 湖は地上部隊を通さない。歩兵で湖畔の飛行場を占領し、
brief = 戦闘機で敵の爆撃機を迎撃せよ。対空戦車の随伴を忘れるな。
# --- 幕間（story = 話者|セリフ。話者空で地の文） ---
story = 湖畔に、放棄された飛行場が点在している。
story = ヴェルナー参謀|空を取られたままでは、この先の平原は渡れん。
story = ミラ少尉|先に飛行場を押さえた側が勝ちます。急ぎましょう。
# --- 勝利直後の幕間 ---
story_win = ミラ少尉|飛行場、確保。空はこちらのものです。
story_win = ヴェルナー参謀|頭の上を気にせず進める。ありがたい話だ。
next_win  = M13
next_lose = LOSE
carry  = 1
bonus  = 800
enemy  = NORMAL
enemy_co = EAGLE  # 空の要衝: 制空権を握られている
sub = CAPTURE:11:拠点を11個以上確保する
sub = SURVIVE:2:FIGHTER:戦闘機を2機以上生存させる
event = TURN:10 | SPAWN:1:FIGHTER:32,4:2 | 敵の増援航空隊が飛来した！

# --- English ---
title@en = Operation 7: Key Airfields
brief@en = Neutral airfields dot the shores of the great lake. Whoever takes them rules the skies.
brief@en = The lake blocks ground units. Capture the lakeside airfields with infantry,
brief@en = and intercept enemy bombers with fighters. Don't forget AA tank escorts.
story@en = Abandoned airfields dot the lakeshore.
story@en = Staff Officer Werner|Without the skies, we can't cross the plains ahead.
story@en = Lt. Mira|Whoever takes the airfields first wins. Let's hurry.
story_win@en = Lt. Mira|Airfields secured. The skies are ours.
story_win@en = Staff Officer Werner|We can advance without watching overhead. Welcome news.
sub_desc@en = Hold at least 11 bases
sub_desc@en = Keep at least 2 fighters alive
event_msg@en = Enemy air reinforcements have arrived!

[node M13]
art   = gfx/brief/m13.png
reward = gfx/reward/m13.png
title = 第8作戦「夜襲」
map   = maps/c17_nightraid.map
brief = 制空権を失った敵は、昼間の移動をやめて夜だけ動くようになった。
brief = ならばこちらも夜に出る。この作戦は最初から最後まで夜だ。
brief = 夜は視界が狭い。中央の平地は見通しが利くぶん丸見えになる。
brief = 両脇の森を伝って回り込み、見つかる前に見つけること。
brief = 偵察部隊を先に出し、敵より広く見えている状態を保て。
# --- 幕間（story = 話者|セリフ。話者空で地の文） ---
story = ヴェルナー参謀|敵が昼に動かなくなった。空を取られたからだ。
story = ミラ少尉|では、こちらも夜に出るということですか。
story = ヴェルナー参謀|そうだ。夜は誰の目も利かん。先に見つけたほうが勝つ。
story = ミラ少尉|……偵察を厚くします。灯りは点けさせません。
# --- 勝利直後の幕間 ---
story_win = ミラ少尉|敵陣、制圧しました。向こうは最後までこちらを捉えられなかったようです。
story_win = ヴェルナー参謀|夜はもう、あいつらの味方ではない。
next_win  = M11
next_lose = LOSE
carry  = 1
bonus  = 700
enemy  = NORMAL
