name@en    = Admiral Wolf
cutin      = gfx/cutin/co_east.png
image      = gfx/co/wolf.png
title      = 海の狼
title@en   = Sea Wolf
desc       = 艦船が非常に強い。陸上部隊には補正がない。
desc@en    = Naval units are very strong. No bonus for ground units.
domain     = SEA
atk_pct    = 25
def_pct    = 10
power_name = 艦砲射撃
