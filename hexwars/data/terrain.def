cost_track = 2
cost_air   = 2
color      = 8C8478
height     = 2
# 壊された拠点の成れの果て。収入も補給も無く、占領もできない。
# 短い遮蔽物なので防御補正は少しだけ残る。
# ここからは工兵の復旧でしか戻らないので breaks_to は無し。

[terrain RUBBLE_PORT]
name       = 破壊された港湾
image      = gfx/terrain/rubble_port.png
char       = Y
def        = 15
cost_foot  = 2
cost_wheel = 2
cost_track = 2
cost_air   = 2
cost_sea   = 2
cost_sub   = 2
color      = 6E7A82
height     = 0
# 港・泊地の破壊後。収入も補給も生産も無く、占領もできない。
# **通行可否は元の港と同じにしてある**。陸の瓦礫にしてしまうと
# 艦船が入れなくなり、海峡や運河を工兵一つで永久に塞げる。
