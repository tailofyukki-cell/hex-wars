# terrain.def - 地形定義（仕様書 5.3）
# 移動コストは2倍整数（道路=1, 平地=2, 0=進入不可）

[terrain PLAIN]
name       = 平地
char       = .
def        = 0
cost_foot  = 2
cost_wheel = 2
cost_track = 2
cost_air   = 2
color      = 9CBF6B

