char       = P
def        = 20
cost_foot  = 2
cost_wheel = 2
cost_track = 2
cost_air   = 2
cost_sea   = 2
cost_sub   = 2
income     = 80
capturable = 1
supplies   = SEA,SUB
color      = 8FA0AC
height     = 1
# 工兵で壊せる。repair_cost は「この地形に戻す」のに要る資金。
breaks_to   = RUBBLE_PORT
repair_cost = 300

