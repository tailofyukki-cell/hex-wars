# terrain.def - 地形定義（仕様書 5.3）
# 移動コストは2倍整数（道路=1, 平地=2, 0=進入不可）
#
# height = 斜め見下ろし表示での起伏（**見た目だけ**。移動・戦闘のルールには一切影響しない）。
#   ヘクス半径32px基準のpx値で、正=高く盛り上がる / 負=沈む。描画時にズーム倍率で拡縮する。
#   目安: 山22 / 丘11 / 首都5 / 森4 / 都市・工場3 / 平地・道路0 / 川-3 / 海-7
#   オプションの「マップ表示」を「平面」にすると height は無視される。
#
# image = セルの絵（assets/ からの相対パス）。**六角形の内側にクリップして貼る**ので、
#   正方形PNGで全面を塗ればよい（四隅ははみ出して見えなくなる）。未指定なら color の
#   単色で描く。同梱の仮絵は tools/gen_terrain_gfx.py（要Pillow）で生成したもの。
#   **絵は「真上から見た地面の模様」として描くこと。** 斜め見下ろし表示では画像が
#   縦0.6倍に潰れる。地面の模様なら潰れても自然（奥行きで縮んで見えるだけ）だが、
#   木や建物を横から見た形で描くと上下に潰れて不自然になる。森は樹冠、街は屋根、
#   山は岩肌を、それぞれ真上から見た形にしてある。
#   基調色は color と揃えること（タイル側面＝崖は color で塗るため、ずれると
#   天面と側面が食い違って見える）。

[terrain PLAIN]
name       = 平地
image      = gfx/terrain/plain.png
char       = .
def        = 0
cost_foot  = 2
cost_wheel = 2
cost_track = 2
cost_air   = 2
color      = 9CBF6B
height     = 0

[terrain ROAD]
name       = 道路
image      = gfx/terrain/road.png
char       = =
def        = 0
cost_foot  = 2
cost_wheel = 1
cost_track = 1
cost_air   = 2
color      = C9B79C
height     = 0
# 工兵で壊せる。repair_cost は「この地形に戻す」のに要る資金。
breaks_to   = PLAIN
repair_cost = 150

