# terrain.def - 地形定義（仕様書 5.3）
# 移動コストは2倍整数（道路=1, 平地=2, 0=進入不可）
#
# height = 斜め見下ろし表示での起伏（**見た目だけ**。移動・戦闘のルールには一切影響しない）。
#   ヘクス半径32px基準のpx値で、正=高く盛り上がる / 負=沈む。描画時にズーム倍率で拡縮する。
#   目安: 山22 / 丘11 / 首都5 / 森4 / 都市・工場3 / 平地・道路0 / 川-3 / 海-7
#   オプションの「マップ表示」を「平面」にすると height は無視される。

[terrain PLAIN]
name       = 平地
char       = .
def        = 0
cost_foot  = 2
cost_wheel = 2
cost_track = 2
cost_air   = 2
color      = 9CBF6B
height     = 0

[terrain ROAD]
name       = 道路
char       = =
def        = 0
cost_foot  = 2
cost_wheel = 1
cost_track = 1
cost_air   = 2
color      = C9B79C
height     = 0

