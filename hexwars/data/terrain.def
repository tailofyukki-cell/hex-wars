# 圏外: マップの輪郭を長方形以外にするための「盤外」。
# 全コスト0=全ユニット進入不可。描画側で 'x' はスキップされる（セーブ互換のため末尾）
[terrain VOID]
name       = 圏外
char       = x
def        = 0
color      = 161A20
height     = 0
