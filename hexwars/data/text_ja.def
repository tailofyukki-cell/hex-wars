# text_ja.def - UI文字列（仕様書 8.4。%記法は printf 書式）

# --- 共通 ---
FACTION0        = 西方同盟
FACTION1        = 東方連邦
NEUTRAL         = 中立
ON              = ON
OFF             = OFF

# --- タイトル ---
TITLE_SUB1      = 大戦略ライク ターン制ウォー・シミュレーション
TITLE_SUB2      = 西方同盟 vs 東方連邦 — 架空WW2大陸戦争
TITLE_CAMPAIGN  = キャンペーン
TITLE_FREE      = フリー対戦
TITLE_LOAD      = ロード
TITLE_OPTIONS   = オプション
TITLE_QUIT      = 終了
TITLE_HINT      = 矢印:選択  Z/Enter:決定

# --- セットアップ ---
SETUP_TITLE     = フリー対戦
SETUP_MAP       = マップ
SETUP_OPP       = 相手（東方連邦）
SETUP_FOG       = 索敵（戦場の霧）
SETUP_CO0       = 指揮官（自軍）
SETUP_CO1       = 指揮官（敵軍）
SETUP_START     = 開始
SETUP_BACK      = タイトルへ戻る
SETUP_NOMAP     = （マップなし）
SETUP_HINT      = 矢印:選択/変更  Z/Enter:決定  X/Esc:戻る
OPP_CPU_EASY    = CPU（EASY）
OPP_CPU_NORMAL  = CPU（NORMAL）
OPP_CPU_HARD    = CPU（HARD）
OPP_HUMAN       = 人間（ホットシート）

# --- オプション ---
# ウィンドウ（タスクバー）に出るゲーム名
WINDOW_TITLE    = HEX WARS

OPT_TITLE       = オプション
OPT_BGM         = BGM音量
OPT_SE          = SE音量
OPT_ANIM        = 戦闘アニメ
OPT_ANIM_VIDEO  = 戦闘アニメを動画で再生
OPT_BACK        = タイトルへ戻る
OPT_HINT        = ←→:変更  Z/Enter:決定  X/Esc:戻る

# --- ロード / セーブ ---
LOAD_TITLE      = ロード
LOAD_AUTO       = オート
LOAD_SLOT_FMT   = スロット%2d %s  %s  ターン%d
LOAD_EMPTY_FMT  = スロット%2d %s  （空き）
LOAD_HINT       = Z/Enter:ロード  X/Esc:戻る
SAVE_TITLE      = セーブ先スロット
SAVE_SLOT_FMT   = スロット%2d  %s  ターン%d
SAVE_EMPTY_FMT  = スロット%2d  （空き）

# --- キャンペーン全体マップ ---
CPNMAP_TITLE    = 作戦全体図
CPNMAP_DONE     = 制圧
CPNMAP_NEXT_FMT = 次の作戦: %s
CPNMAP_HINT     = Z:出撃準備へ  C:指揮官変更  X:タイトルへ

# --- ブリーフィング ---
BRIEF_CARRY_FMT = 持越し部隊: %d ユニット   持越し資金: +%dG
BRIEF_STORE_FMT = 倉庫に %d ユニット保管中（生産拠点で無料で出撃可）
BRIEF_GO        = Z / クリックで出撃
BRIEF_NONODE    = （ノードなし）

# --- ご褒美画像 ---
REWARD_TITLE      = 任務達成！
REWARD_HINT       = Z / クリックで次へ
REWARD_NONE       = （画像なし）

# --- 結果 ---
RESULT_WIN_FMT    = %s軍の勝利！
RESULT_DRAW       = 引き分け
RESULT_TURNS_FMT  = 経過ターン: %d
RESULT_LOSSES_FMT = 損失ユニット  %s軍: %d   %s軍: %d
RESULT_NEXT_FMT   = 次の作戦: %s
RESULT_CARRY_FMT  = 持越し部隊 %d ユニット / 持越し資金 +%dG
RESULT_NEXT_HINT  = Z:次の作戦へ  X:タイトルへ
RESULT_CLEAR      = キャンペーンクリア！
RESULT_CLEAR_SUB  = 大陸に平和が戻った — Z / クリックでタイトルへ
RESULT_LOSE       = 作戦は失敗した…
RESULT_RETRY_HINT = Z:再挑戦  X:タイトルへ
RESULT_HINT       = Z / クリックでタイトルへ

# --- 作戦評価（S/A/B/C）---
RANK_TITLE_FMT       = 作戦評価  %s
RANK_DETAIL_FMT      = 速さ %d ／ 温存 %d ／ 戦果 %d  →  総合 %d
RANK_DETAIL_BONUS_FMT = 速さ %d ／ 温存 %d ／ 戦果 %d  →  総合 %d   評価ボーナス +%dG
CO_LOCKED_FMT        = 未解禁の指揮官 %d 人（作戦をクリアすると解禁）

# --- 戦闘画面 ---
BANNER_TURN_FMT = ターン %d — %s軍の手番
TOP_TURNLIM_FMT = %s  ターン %d/%d
